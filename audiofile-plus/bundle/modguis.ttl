@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .

# Based on the Audio File modgui from MOD's mod-lv2-data (plugins-fixed/carla-files.lv2,
# commit 6f5e899c8579c9542b7f8f4fd323ed198eed7fa7). The knob, switch, screenshot and
# thumbnail images are taken unchanged from there.

<urn:danmigdev:audiofile-plus>
    mod:brand "danmigdev" ;
    mod:label "Audio File Plus" ;
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-audio.html> ;
        modgui:javascript <modgui/javascript-audio.js> ;
        modgui:stylesheet <modgui/stylesheet-audio.css> ;
        modgui:screenshot <modgui/screenshot-audio.png> ;
        modgui:thumbnail <modgui/thumbnail-audio.png> ;
        modgui:monitoredOutputs [
             lv2:symbol "num_channels"
         ] , [
             lv2:symbol "bit_rate"
         ] , [
             lv2:symbol "bit_depth"
         ] , [
             lv2:symbol "sample_rate"
         ] , [
             lv2:symbol "length"
         ] , [
             lv2:symbol "position"
         ] ;
    ] .
